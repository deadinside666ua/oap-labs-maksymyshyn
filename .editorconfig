# EditorConfig: базові правила для будь-якого редактора (VS 2022, VS Code, CLion читають його самі).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c}]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# Файли Visual Studio генеруються з CRLF — не чіпаємо
[*.{sln,vcxproj,vcxproj.filters}]
end_of_line = crlf
indent_style = space
indent_size = 2
